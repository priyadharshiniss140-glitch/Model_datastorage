{
  "name": "threadbase-vote-endpoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Threadbase post voting endpoint built with Express and Prisma 7",
  "scripts": {
    "dev": "tsx src/app.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx src/test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "supertest": "^7.1.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}