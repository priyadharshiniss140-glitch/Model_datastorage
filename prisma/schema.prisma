generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id           Int           @id @default(autoincrement())
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  email        String        @unique(map: "patients_email_key") @db.VarChar(255)
  phone        String?       @db.VarChar(30)
  dateOfBirth  DateTime?     @map("date_of_birth") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  Appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id           Int           @id @default(autoincrement())
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  specialty    String        @db.VarChar(100)
  email        String        @unique(map: "doctors_email_key") @db.VarChar(255)
  phone        String?       @db.VarChar(30)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  Appointments Appointment[]

  @@index([specialty], map: "doctors_specialty_idx")
  @@map("doctors")
}

model Appointment {
  id              Int      @id @default(autoincrement())
  patientId       Int      @map("patient_id")
  doctorId        Int      @map("doctor_id")
  appointmentDate DateTime @map("appointment_date") @db.Timestamp(6)
  reason          String?  @db.Text
  status          String   @default("scheduled") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  Patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "appointments_patient_id_fkey")
  Doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "appointments_doctor_id_fkey")

  @@index([patientId], map: "appointments_patient_id_idx")
  @@index([doctorId, appointmentDate], map: "appointments_doctor_id_appointment_date_idx")
  @@map("appointments")
}
